        const palette = {
            blue: '#1a56db',
            green: '#047857',
            red: '#c81e1e',
            neutral: '#6b7280',
            lightBlue: '#a4cafe',
            lightGreen: '#6ee7b7',
        };

        const tooltipTitleCallback = (tooltipItems) => {
            const item = tooltipItems[0];
            let label = item.chart.data.labels[item.dataIndex];
            return Array.isArray(label) ? label.join(' ') : label;
        };

        const defaultChartOptions = {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { display: false },
                tooltip: {
                    callbacks: { title: tooltipTitleCallback },
                    backgroundColor: '#ffffff',
                    titleColor: '#333333',
                    bodyColor: '#333333',
                    borderColor: '#dddddd',
                    borderWidth: 1,
                }
            },
        };

        function showView(viewName) {
            document.getElementById('dashboard-view').classList.toggle('hidden', viewName !== 'dashboard');
            document.getElementById('explorer-view').classList.toggle('hidden', viewName !== 'explorer');
            document.getElementById('btnDashboard').classList.toggle('active', viewName === 'dashboard');
            document.getElementById('btnExplorer').classList.toggle('active', viewName === 'explorer');
        }

        function updateRaceDetails(raceNumber) {
            const data = raceData[raceNumber];
            if (!data) return;

            document.getElementById('race-details-placeholder').classList.add('hidden');
            document.getElementById('race-details-display').classList.remove('hidden');

            document.getElementById('raceTitle').textContent = data.title;
            document.getElementById('raceConditions').textContent = data.conditions;
            document.getElementById('racePace').textContent = data.pace;

            const contendersEl = document.getElementById('raceContenders');
            contendersEl.innerHTML = data.contenders.map(c => `
                <div class="border-l-4 pl-3" style="border-color: ${palette.blue}">
                    <p class="font-bold text-gray-800">#${c.num} ${c.name} (${c.odds})</p>
                    <p class="text-xs text-gray-500">${c.jockey} / ${c.trainer}</p>
                    <p class="text-sm mt-1">${c.key}</p>
                </div>
            `).join('');
            
            const selectionsEl = document.getElementById('raceSelections');
            selectionsEl.innerHTML = `
                <p><strong class="text-gray-900">Top Selection:</strong> ${data.selections.top}</p>
                <p><strong class="text-gray-900">Second Choice:</strong> ${data.selections.second}</p>
                <p><strong class="text-gray-900">Third Choice:</strong> ${data.selections.third}</p>
                <p class="mt-2"><strong class="text-gray-900">Wagering Strategy:</strong> ${data.selections.strategy}</p>
            `;
        }

